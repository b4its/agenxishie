<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <!--
            APP_KEY memakai nilai .env (runtime, bukan override test) karena
            Livewire v4 menghitung prefix endpoint update dari hash APP_KEY.
            Bila override test memakai key berbeda, route update Livewire yang
            terdaftar saat boot (prefix dari .env) tak akan cocok dengan URI
            hasil perhitungan ulang (prefix dari key test) sehingga setiap
            call/set Livewire::test() 404 dan state komponen hilang.
            .env.example menyediakan key default deterministik untuk CI
            (composer post-root-package-install membuat .env dari .env.example
            saat .env belum ada), jadi nilai di sini boleh hardcode.
        -->
        <env name="APP_KEY" value="base64:tFCJ2+kYxICd0dJrQOrriP46ilZ/gkKQqM7Ece63UlQ=" force="false"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!--
            Pengujian dijalankan di atas MySQL (InnoDB + JSON + FULLTEXT) sesuai PRD.
            Untuk CI cepat tanpa MySQL, override dengan env DB_CONNECTION=sqlite dan
            DB_DATABASE=:memory: (target `make ci`); migrasi FULLTEXT otomatis dilewati
            pada driver non-MySQL. Nilai di bawah menjadi default, bukan paksa, agar
            override dari environment (CI) tetap dihormati.
        -->
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_HOST" value="db"/>
        <env name="DB_PORT" value="3306"/>
        <env name="DB_DATABASE" value="xishie_testing"/>
        <env name="DB_USERNAME" value="root"/>
        <env name="DB_PASSWORD" value=""/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <!-- Uji deterministik: default tanpa API key integrasi agar test base
             memakai jalur operator; test integrasi menyetel key eksplisit.
             Base URL diarahkan ke port tertutup (127.0.0.1:1) agar probe
             isAvailable() gagal instan (bukan DNS-hang) saat tidak di-fake. -->
        <env name="OMNIGENSI_API_KEY" value="" force="true"/>
        <env name="OMNIGENSI_BASE_URL" value="http://127.0.0.1:1" force="true"/>
        <env name="OMNIGENSI_AGENTS_ENABLED" value="false" force="true"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>

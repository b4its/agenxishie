APP_NAME="Agen Xishie"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8208

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Host "db" adalah nama service di docker-compose.yml.
# Saat menjalankan di host, ganti dengan 127.0.0.1 dan DB_PORT=3514.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=xishie
DB_USERNAME=root
DB_PASSWORD=

# phpMyAdmin (GUI database) — port host, dijalankan oleh `make phpmyadmin`
# atau otomatis ikut `make up`. Buka http://localhost:8422 (user root, password kosong).
PHPMYADMIN_HOST_PORT=8422

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Laravel Reverb (real-time agent telemetry, port 8080 internal)
REVERB_APP_ID=100001
REVERB_APP_KEY=xishie-reverb-key
REVERB_APP_SECRET=xishie-reverb-secret
REVERB_HOST=localhost
REVERB_PORT=8282
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- AI Chat (Omnigensi backend) ---
# Base URL backend omnigensi (FastAPI). Di host: http://localhost:8123.
# Di dalam container: gunakan host.docker.internal:8123 (lihat docker-compose.omnigensi.yml).
OMNIGENSI_BASE_URL=http://host.docker.internal:8123
# Password operator Omnigensi (APP_PASSWORD di backend).
OMNIGENSI_PASSWORD=123
OMNIGENSI_TIMEOUT=120
OMNIGENSI_CONNECT_TIMEOUT=10
# API Key integrasi dari halaman Connected Projects omnigensi (omni_live_...).
OMNIGENSI_API_KEY=
